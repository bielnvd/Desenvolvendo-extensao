{

"manifest_version" : 3,
"name" : "MVP Extension",
"version" : "1.0.0",
"description" : "Desenvolvendo apenas com minha mente.",
"permissions": ["activeTab", "storage"],
"background" : {
"service_worker" : "service.js"
},
  "content_scripts" : [
  {
    "matches" : ["<all_urls>"],
    "js" : "[content.js]"
  }
  ],
  "action" : {
   "default_popup" : "index.html",
   "default_icon" : "icon.png"
}

}
